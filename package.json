{
  "name": "strange-loop-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Strange Loop Lab — a deterministic computational laboratory for observing self-reference and level-crossing dynamics.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "probe": "tsx tools/probe.ts",
    "validate": "tsx tools/validate.ts",
    "analyze": "tsx tools/analyze.ts",
    "selfaudit": "tsx tools/selfaudit.ts",
    "validate:v02": "tsx tools/v02validate.ts",
    "validate:v03": "tsx tools/v03validate.ts",
    "validate:v04": "tsx tools/v04validate.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
